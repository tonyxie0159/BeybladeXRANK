@page
@model BeybladeRecordSystem.Pages.Account.RegisterModel
@{ ViewData["Title"] = "建立帳號"; }
<div class="auth-shell">
    <header class="auth-heading"><p class="eyebrow">JOIN THE ARENA</p><h1>建立帳號</h1><p>建立專屬戰績，開始記錄每一場對戰。</p></header>
    <form method="post" class="card auth-card">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3"><label asp-for="Account" class="form-label">帳號</label><input asp-for="Account" class="form-control" autocomplete="username" autofocus /><span asp-validation-for="Account" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label">密碼</label><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger small"></span></div>
        <div class="mb-4"><label asp-for="DisplayName" class="form-label">顯示名稱</label><input asp-for="DisplayName" class="form-control" autocomplete="nickname" /><span asp-validation-for="DisplayName" class="text-danger small"></span><div class="form-text text-muted">對手與賽事參加者會看到這個名稱。</div></div>
        <button class="btn btn-primary btn-lg w-100">建立帳號</button>
    </form>
    <p class="auth-footer">已經有帳號？ <a asp-page="/Account/Login">返回登入</a></p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
