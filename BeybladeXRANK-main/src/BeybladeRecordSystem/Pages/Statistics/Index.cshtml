@page
@model BeybladeRecordSystem.Pages.Statistics.IndexModel
@{ ViewData["Title"] = "我的戰績"; }
<h1>我的戰績</h1><div class="row g-2 mb-4"><div class="col-6 col-md"><div class="card card-body text-center"><small>勝／敗</small><strong>@Model.Summary.Wins / @Model.Summary.Losses</strong></div></div><div class="col-6 col-md"><div class="card card-body text-center"><small>勝率</small><strong>@Model.Summary.WinRate.ToString("P0")</strong></div></div><div class="col-6 col-md"><div class="card card-body text-center"><small>得／失分</small><strong>@Model.Summary.Score / @Model.Summary.AgainstScore</strong></div></div><div class="col-6 col-md"><div class="card card-body text-center"><small>失誤失分</small><strong>@Model.Summary.LaunchFaultAgainstScore</strong></div></div></div>
<section class="mb-4"><div class="d-flex justify-content-between align-items-center"><h2 class="h4">我的陀螺</h2><form method="get"><select name="sort" class="form-select" onchange="this.form.submit()"><option value="score-desc" selected="@(Model.Sort == "score-desc")">得分：高到低</option><option value="score-asc" selected="@(Model.Sort == "score-asc")">得分：低到高</option><option value="against-desc" selected="@(Model.Sort == "against-desc")">失分：高到低</option><option value="against-asc" selected="@(Model.Sort == "against-asc")">失分：低到高</option><option value="winrate-desc" selected="@(Model.Sort == "winrate-desc")">勝率：高到低</option><option value="winrate-asc" selected="@(Model.Sort == "winrate-asc")">勝率：低到高</option></select></form></div><div class="table-responsive"><table class="table"><thead><tr><th>陀螺</th><th>勝/敗</th><th>勝率</th><th>得分</th><th>失分</th><th>失誤失分</th></tr></thead><tbody>@foreach (var item in Model.Beyblades) { <tr><td>@item.Name</td><td>@item.Wins/@item.Losses</td><td>@item.WinRate.ToString("P0")</td><td>@item.Score</td><td>@item.AgainstScore</td><td>@item.LaunchFaultAgainstScore</td></tr> }</tbody></table></div></section>
<section class="mb-4"><h2 class="h4">對手戰績</h2><div class="table-responsive"><table class="table"><thead><tr><th>對手</th><th>勝/敗</th><th>勝率</th><th>得分</th><th>失分</th></tr></thead><tbody>@foreach (var item in Model.Opponents) { <tr><td><a asp-page="Opponent" asp-route-id="@item.OpponentId">@item.DisplayName</a></td><td>@item.Wins/@item.Losses</td><td>@item.WinRate.ToString("P0")</td><td>@item.Score</td><td>@item.AgainstScore</td></tr> }</tbody></table></div></section>
<section><h2 class="h4">對戰歷史</h2><div class="list-group">@foreach (var item in Model.History) { <a asp-page="/Battles/Battle" asp-route-id="@item.BattleId" class="list-group-item list-group-item-action d-flex justify-content-between"><span>vs @item.OpponentDisplayName — @(item.Won ? "勝" : "敗")</span><strong>@item.MyScore : @item.OpponentScore</strong></a> }</div></section>
