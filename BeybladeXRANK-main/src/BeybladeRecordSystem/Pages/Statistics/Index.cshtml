@page
@using BeybladeRecordSystem.Domain.Enums
@model BeybladeRecordSystem.Pages.Statistics.IndexModel
@{ ViewData["Title"] = "我的戰績"; }

<h1>我的戰績</h1>
<p class="text-muted">各對戰來源分開計算；B／X Side 依開賽前鎖定的站位即時計算。</p>

<section class="mb-4">
    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-end gap-2">
        <div>
            <h2 class="h4 mb-1">個人分項戰績</h2>
            <p class="text-muted mb-0">團體賽的隊伍結果與實際上場小局維持分列。</p>
        </div>
        <form method="get" class="row g-2">
            <input type="hidden" name="source" value="@Model.Source" />
            <input type="hidden" name="side" value="@Model.Side" />
            <input type="hidden" name="sort" value="@Model.Sort" />
            <div class="col-sm-auto">
                <label for="personalSource" class="form-label small mb-1">資料來源</label>
                <select id="personalSource" name="personalSource" class="form-select" onchange="this.form.submit()">
                    <option value="all" selected="@(Model.PersonalSource == "all")">全部分項</option>
                    <option value="quick" selected="@(Model.PersonalSource == "quick")">快速對戰</option>
                    <option value="individual" selected="@(Model.PersonalSource == "individual")">個人賽</option>
                    <option value="team" selected="@(Model.PersonalSource == "team")">團體賽</option>
                </select>
            </div>
            <div class="col-sm-auto">
                <label for="personalSide" class="form-label small mb-1">站位篩選</label>
                <select id="personalSide" name="personalSide" class="form-select" onchange="this.form.submit()">
                    <option value="all" selected="@(Model.PersonalSide == "all")">B＋X Side</option>
                    <option value="b" selected="@(Model.PersonalSide == "b")">只看 B Side</option>
                    <option value="x" selected="@(Model.PersonalSide == "x")">只看 X Side</option>
                </select>
            </div>
            <div class="col-sm-auto">
                <label for="personalSort" class="form-label small mb-1">排序</label>
                <select id="personalSort" name="personalSort" class="form-select" onchange="this.form.submit()">
                    <option value="winrate-desc" selected="@(Model.PersonalSort == "winrate-desc")">勝率：高到低</option>
                    <option value="winrate-asc" selected="@(Model.PersonalSort == "winrate-asc")">勝率：低到高</option>
                    <option value="score-desc" selected="@(Model.PersonalSort == "score-desc")">得分：高到低</option>
                    <option value="score-asc" selected="@(Model.PersonalSort == "score-asc")">得分：低到高</option>
                    <option value="against-desc" selected="@(Model.PersonalSort == "against-desc")">失分：高到低</option>
                    <option value="against-asc" selected="@(Model.PersonalSort == "against-asc")">失分：低到高</option>
                    <option value="difference-desc" selected="@(Model.PersonalSort == "difference-desc")">得失分差：高到低</option>
                    <option value="difference-asc" selected="@(Model.PersonalSort == "difference-asc")">得失分差：低到高</option>
                    <option value="b-winrate-desc" selected="@(Model.PersonalSort == "b-winrate-desc")">B Side 勝率：高到低</option>
                    <option value="b-winrate-asc" selected="@(Model.PersonalSort == "b-winrate-asc")">B Side 勝率：低到高</option>
                    <option value="x-winrate-desc" selected="@(Model.PersonalSort == "x-winrate-desc")">X Side 勝率：高到低</option>
                    <option value="x-winrate-asc" selected="@(Model.PersonalSort == "x-winrate-asc")">X Side 勝率：低到高</option>
                </select>
            </div>
        </form>
    </div>
    <div class="table-responsive mt-3">
        <table class="table align-middle">
            <thead><tr><th>分項</th><th>勝／敗</th><th>勝率</th><th>得／失分</th><th>得失分差</th><th>B Side</th><th>X Side</th><th>失誤失分</th></tr></thead>
            <tbody>
            @foreach (var row in Model.PersonalRows)
            {
                <tr>
                    <td class="fw-semibold">@row.Label</td>
                    <td>@row.Summary.Wins / @row.Summary.Losses</td>
                    <td>@row.Summary.WinRate.ToString("P0")</td>
                    <td>@row.Summary.Score / @row.Summary.AgainstScore</td>
                    <td class="@(row.Summary.ScoreDifference >= 0 ? "text-success" : "text-danger")">@row.Summary.ScoreDifference</td>
                    <td>@row.Summary.BSide.Wins / @row.Summary.BSide.Losses（@row.Summary.BSide.WinRate.ToString("P0")）</td>
                    <td>@row.Summary.XSide.Wins / @row.Summary.XSide.Losses（@row.Summary.XSide.WinRate.ToString("P0")）</td>
                    <td>@row.Summary.LaunchFaultAgainstScore</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-2">
        <div>
            <h2 class="h4 mb-1">我的陀螺</h2>
            <p class="text-muted mb-0">只計入已完成的小局；錦標賽取消前已完成的小局仍保留。</p>
        </div>
        <form method="get" class="row g-2">
            <input type="hidden" name="personalSource" value="@Model.PersonalSource" />
            <input type="hidden" name="personalSide" value="@Model.PersonalSide" />
            <input type="hidden" name="personalSort" value="@Model.PersonalSort" />
            <div class="col-sm-auto">
                <label for="source" class="form-label small mb-1">資料來源</label>
                <select id="source" name="source" class="form-select" onchange="this.form.submit()">
                    <option value="all" selected="@(Model.Source == "all")">全部（@Model.Samples.All 局）</option>
                    <option value="quick" selected="@(Model.Source == "quick")">快速對戰（@Model.Samples.Quick 局）</option>
                    <option value="individual" selected="@(Model.Source == "individual")">個人賽（@Model.Samples.TournamentIndividual 局）</option>
                    <option value="team" selected="@(Model.Source == "team")">團體賽（@Model.Samples.TournamentTeam 局）</option>
                </select>
            </div>
            <div class="col-sm-auto">
                <label for="side" class="form-label small mb-1">站位篩選</label>
                <select id="side" name="side" class="form-select" onchange="this.form.submit()">
                    <option value="all" selected="@(Model.Side == "all")">B＋X（@Model.SideSamples.All 局）</option>
                    <option value="b" selected="@(Model.Side == "b")">B Side（@Model.SideSamples.B 局）</option>
                    <option value="x" selected="@(Model.Side == "x")">X Side（@Model.SideSamples.X 局）</option>
                </select>
            </div>
            <div class="col-sm-auto">
                <label for="sort" class="form-label small mb-1">排序</label>
                <select id="sort" name="sort" class="form-select" onchange="this.form.submit()">
                    <option value="score-desc" selected="@(Model.Sort == "score-desc")">得分：高到低</option>
                    <option value="score-asc" selected="@(Model.Sort == "score-asc")">得分：低到高</option>
                    <option value="against-desc" selected="@(Model.Sort == "against-desc")">失分：高到低</option>
                    <option value="against-asc" selected="@(Model.Sort == "against-asc")">失分：低到高</option>
                    <option value="difference-desc" selected="@(Model.Sort == "difference-desc")">得失分差：高到低</option>
                    <option value="difference-asc" selected="@(Model.Sort == "difference-asc")">得失分差：低到高</option>
                    <option value="winrate-desc" selected="@(Model.Sort == "winrate-desc")">勝率：高到低</option>
                    <option value="winrate-asc" selected="@(Model.Sort == "winrate-asc")">勝率：低到高</option>
                    <option value="b-winrate-desc" selected="@(Model.Sort == "b-winrate-desc")">B Side 勝率：高到低</option>
                    <option value="b-winrate-asc" selected="@(Model.Sort == "b-winrate-asc")">B Side 勝率：低到高</option>
                    <option value="x-winrate-desc" selected="@(Model.Sort == "x-winrate-desc")">X Side 勝率：高到低</option>
                    <option value="x-winrate-asc" selected="@(Model.Sort == "x-winrate-asc")">X Side 勝率：低到高</option>
                </select>
            </div>
        </form>
    </div>
    <div class="table-responsive mt-3">
        <table class="table align-middle">
            <thead>
                <tr><th>陀螺</th><th>勝／敗</th><th>勝率</th><th>得／失分</th><th>差</th><th>B Side</th><th>X Side</th><th>樣本</th><th>平均得／失分</th><th>發射失誤</th><th>結果類型（得／失）</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Beyblades)
            {
                <tr>
                    <td class="fw-semibold">@item.Name</td>
                    <td>@item.Wins / @item.Losses</td>
                    <td>@item.WinRate.ToString("P0")</td>
                    <td>@item.Score / @item.AgainstScore</td>
                    <td class="@(item.ScoreDifference >= 0 ? "text-success" : "text-danger")">@item.ScoreDifference</td>
                    <td>@item.BSide.Wins / @item.BSide.Losses（@item.BSide.WinRate.ToString("P0")）</td>
                    <td>@item.XSide.Wins / @item.XSide.Losses（@item.XSide.WinRate.ToString("P0")）</td>
                    <td>@item.RoundCount 局</td>
                    <td>@item.AverageScore.ToString("0.##") / @item.AverageAgainstScore.ToString("0.##")</td>
                    <td>@item.LaunchFaultCount 次／失 @item.LaunchFaultAgainstScore 分</td>
                    <td class="small text-nowrap">
                        轉停 @item.ResultTypes.SpinFinishFor/@item.ResultTypes.SpinFinishAgainst、
                        擊飛 @item.ResultTypes.KnockOutFor/@item.ResultTypes.KnockOutAgainst、
                        爆裂 @item.ResultTypes.BurstFor/@item.ResultTypes.BurstAgainst、
                        極限 @item.ResultTypes.ExtremeFor/@item.ResultTypes.ExtremeAgainst
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="mb-4">
    <h2 class="h4">對手戰績</h2>
    <p class="text-muted">團體賽依我實際上場的小局對手計算，不拿隊伍勝負冒充個人對戰。</p>
    <div class="row g-3">
        <div class="col-xl-4">
            <div class="card h-100">
                <div class="card-header fw-semibold">快速對戰</div>
                <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>對手</th><th>勝／敗</th><th>得／失分</th></tr></thead><tbody>
                @foreach (var item in Model.QuickOpponents)
                {
                    <tr><td><a asp-page="Opponent" asp-route-id="@item.OpponentId" asp-route-source="quick">@item.DisplayName</a></td><td>@item.Wins / @item.Losses<br><small>@item.WinRate.ToString("P0")</small></td><td>@item.Score / @item.AgainstScore</td></tr>
                }
                @if (!Model.QuickOpponents.Any()) { <tr><td colspan="3" class="text-muted">尚無紀錄</td></tr> }
                </tbody></table></div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card h-100">
                <div class="card-header fw-semibold">錦標賽個人賽</div>
                <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>對手</th><th>勝／敗</th><th>得／失分</th></tr></thead><tbody>
                @foreach (var item in Model.IndividualOpponents)
                {
                    <tr><td><a asp-page="Opponent" asp-route-id="@item.OpponentId" asp-route-source="individual">@item.DisplayName</a></td><td>@item.Wins / @item.Losses<br><small>@item.WinRate.ToString("P0")</small></td><td>@item.Score / @item.AgainstScore</td></tr>
                }
                @if (!Model.IndividualOpponents.Any()) { <tr><td colspan="3" class="text-muted">尚無紀錄</td></tr> }
                </tbody></table></div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card h-100">
                <div class="card-header fw-semibold">團體賽實際小局</div>
                <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>對手</th><th>勝／敗</th><th>得／失分</th></tr></thead><tbody>
                @foreach (var item in Model.TeamOpponents)
                {
                    <tr><td><a asp-page="Opponent" asp-route-id="@item.OpponentId" asp-route-source="team">@item.DisplayName</a></td><td>@item.Wins / @item.Losses<br><small>@item.WinRate.ToString("P0")</small></td><td>@item.Score / @item.AgainstScore</td></tr>
                }
                @if (!Model.TeamOpponents.Any()) { <tr><td colspan="3" class="text-muted">尚無紀錄</td></tr> }
                </tbody></table></div>
            </div>
        </div>
    </div>
</section>

<section>
    <h2 class="h4">對戰歷史</h2>
    <div class="list-group">
    @foreach (var item in Model.History)
    {
        var sourceLabel = item.SourceType switch
        {
            BattleSourceType.Quick => "快速",
            BattleSourceType.TournamentIndividual => "個人賽",
            _ => "團體賽"
        };
        var sideLabel = item.Side is null ? "未記錄 Side" : $"{item.Side} Side";
        <a asp-page="/Battles/Battle" asp-route-id="@item.BattleId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3">
            <span><span class="badge text-bg-secondary me-2">@sourceLabel</span><span class="badge @(item.Side == BattleSide.B ? "text-bg-primary" : item.Side == BattleSide.X ? "text-bg-danger" : "text-bg-light") me-2">@sideLabel</span>vs @item.OpponentDisplayName — @(item.Won ? "勝" : "敗")@(item.IsTeamResult ? "（隊伍結果）" : string.Empty)</span>
            <strong class="text-nowrap">@item.MyScore : @item.OpponentScore</strong>
        </a>
    }
    @if (!Model.History.Any())
    {
        <div class="list-group-item text-muted">尚無已完成的對戰紀錄。</div>
    }
    </div>
</section>
