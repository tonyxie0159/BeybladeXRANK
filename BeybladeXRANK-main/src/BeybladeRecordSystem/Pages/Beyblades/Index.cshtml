@page
@model BeybladeRecordSystem.Pages.Beyblades.IndexModel
@{ ViewData["Title"] = "我的陀螺"; }
<header class="page-header"><div><p class="eyebrow">MY BEYBLADES</p><h1>我的陀螺</h1><p>管理可在快速對戰與賽事中使用的陀螺。</p></div><div class="page-actions"><a asp-page="Create" class="btn btn-primary">＋ 新增陀螺</a></div></header>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (!Model.Beyblades.Any()) { <div class="empty-state"><h2>還沒有陀螺</h2><p class="text-muted">先新增至少三顆陀螺，就能完整進行標準快速對戰。</p><a asp-page="Create" class="btn btn-primary">新增第一顆陀螺</a></div> }
else { <div class="list-group">@foreach (var beyblade in Model.Beyblades) { <div class="list-group-item d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 p-3"><strong>@beyblade.Name</strong><span class="d-flex gap-2"><a asp-page="Edit" asp-route-id="@beyblade.Id" class="btn btn-outline-primary btn-sm">編輯名稱</a><form method="post" asp-page-handler="Delete"><input type="hidden" name="id" value="@beyblade.Id" /><button class="btn btn-outline-danger btn-sm" onclick="return confirm('確定刪除 @beyblade.Name？若已有歷史紀錄，歷史仍會保留當時名稱。')">刪除</button></form></span></div>}</div> }
