@page "{id:int}"
@model BeybladeRecordSystem.Pages.Battles.ReorderModel
@{ ViewData["Title"] = "重新排列陣容"; var originals = Model.Battle.Lineups.Where(x => x.SequenceNo == 1).OrderBy(x => x.PositionNo).ToList(); }
<h1>重新排列陣容</h1><p>只能變更順位；陀螺不可替換，分數會保留。</p><form method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3"><div class="col-md-6"><h2 class="h5">@Model.Battle.PlayerA.DisplayName</h2>@for (var i = 0; i < 3; i++) { <label class="form-label">@((i + 1).ToString()) 號</label><select name="PlayerAIds" class="form-select mb-2">@foreach (var blade in originals) { <option value="@blade.PlayerABeybladeId">@blade.PlayerABeybladeNameSnapshot</option> }</select> }</div><div class="col-md-6"><h2 class="h5">@Model.Battle.PlayerB.DisplayName</h2>@for (var i = 0; i < 3; i++) { <label class="form-label">@((i + 1).ToString()) 號</label><select name="PlayerBIds" class="form-select mb-2">@foreach (var blade in originals) { <option value="@blade.PlayerBBeybladeId">@blade.PlayerBBeybladeNameSnapshot</option> }</select> }</div></div><button class="btn btn-primary btn-lg mt-3">確認重排</button><a asp-page="Battle" asp-route-id="@Model.Battle.Id" class="btn btn-link mt-3">取消</a></form>
