@page "{id:int}"
@model BeybladeRecordSystem.Pages.Battles.ReviseModel
@using BeybladeRecordSystem.Domain.Enums
@{ ViewData["Title"] = "Round 判決修改"; }
<h1>Round 判決修改</h1><p class="text-muted">修改會保留原有效事件快照，並重新計算整場比分與勝利條件。</p><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>@foreach (var round in Model.Battle.Rounds.OrderBy(x => x.RoundNo)) { <div class="card mb-3"><div class="card-body"><h2 class="h5">Round @round.RoundNo：@round.PlayerABeybladeNameSnapshot vs @round.PlayerBBeybladeNameSnapshot</h2><ul class="small">@foreach (var item in round.Events.OrderBy(x => x.EventSequence)) { <li class="@(item.IsEffective ? "" : "text-decoration-line-through text-muted")">@item.EventType @if (item.ResultType is not null) { <text>— @item.ResultType (+@item.ScoreAwarded)</text> }</li> }</ul><form method="post" class="row g-2"><input type="hidden" asp-for="RoundId" value="@round.Id" /><div class="col-md-4"><label class="form-label">勝者</label><select asp-for="WinnerPlayerId" class="form-select"><option value="@Model.Battle.PlayerAId">@Model.Battle.PlayerA.DisplayName</option><option value="@Model.Battle.PlayerBId">@Model.Battle.PlayerB.DisplayName</option></select></div><div class="col-md-4"><label class="form-label">勝利方式</label><select asp-for="ResultType" asp-items="Html.GetEnumSelectList<ResultType>()" class="form-select"></select></div><div class="col-md-4"><label class="form-label">修改原因（選填）</label><input asp-for="Reason" class="form-control" /></div><div class="col-12"><button class="btn btn-warning">修改此 Round</button></div></form></div></div> }<a asp-page="Battle" asp-route-id="@Model.Battle.Id" class="btn btn-link">回對戰畫面</a>
