@page "{id:int}"
@model BeybladeRecordSystem.Pages.Battles.BattleModel
@using BeybladeRecordSystem.Domain.Enums
@{ ViewData["Title"] = "對戰裁判"; }
<div class="sticky-top bg-body pt-2 pb-3 border-bottom mb-3"><div class="row text-center align-items-center"><div class="col"><strong>@Model.Battle.PlayerA.DisplayName</strong><div class="display-4">@Model.Battle.PlayerAScore</div></div><div class="col-2">vs</div><div class="col"><strong>@Model.Battle.PlayerB.DisplayName</strong><div class="display-4">@Model.Battle.PlayerBScore</div></div></div></div>
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (Model.Battle.Status == BattleStatus.VictoryPendingCompletion) { <div class="alert alert-warning"><strong>已達勝利條件</strong>，請確認紀錄後按「對戰結束」。</div><form method="post" asp-page-handler="Finish"><input type="hidden" name="id" value="@Model.Battle.Id" /><button class="btn btn-danger btn-lg w-100">對戰結束</button></form> }
@if (Model.Battle.Status == BattleStatus.Completed) { <div class="alert alert-success">對戰已完成。</div> }
<div class="d-flex gap-2 mb-3"><a asp-page="Revise" asp-route-id="@Model.Battle.Id" class="btn btn-outline-secondary">Round 判決修改</a>@if (Model.CanReorder) { <a asp-page="Reorder" asp-route-id="@Model.Battle.Id" class="btn btn-outline-primary">重新排列陣容</a> }</div>
@if (Model.CurrentRound is not null) { <section class="card card-body mb-3"><h1 class="h4">Round @Model.CurrentRound.RoundNo：@Model.CurrentRound.PlayerABeybladeNameSnapshot vs @Model.CurrentRound.PlayerBBeybladeNameSnapshot</h1><div class="small text-muted mb-3">@Model.CurrentRound.PlayerABeybladeNameSnapshot 失誤：@BeybladeRecordSystem.Domain.BattleRules.FaultCount(Model.CurrentRound.Events, Model.Battle.PlayerAId)　@Model.CurrentRound.PlayerBBeybladeNameSnapshot 失誤：@BeybladeRecordSystem.Domain.BattleRules.FaultCount(Model.CurrentRound.Events, Model.Battle.PlayerBId)</div>@if (Model.CanOperate && Model.Battle.Status == BattleStatus.InProgress) { <div class="row g-2 mb-3"><div class="col-6"><form method="post" asp-page-handler="Fault"><input type="hidden" name="id" value="@Model.Battle.Id" /><input type="hidden" name="playerId" value="@Model.Battle.PlayerAId" /><button class="btn btn-outline-danger btn-lg w-100">@Model.Battle.PlayerA.DisplayName 發射失誤</button></form></div><div class="col-6"><form method="post" asp-page-handler="Fault"><input type="hidden" name="id" value="@Model.Battle.Id" /><input type="hidden" name="playerId" value="@Model.Battle.PlayerBId" /><button class="btn btn-outline-danger btn-lg w-100">@Model.Battle.PlayerB.DisplayName 發射失誤</button></form></div></div>@if (!Model.CurrentRound.Events.Any(x => x.IsEffective && x.EventType == BattleRoundEventType.BattleResult)) { <h2 class="h5">記錄勝負（點選得分方）</h2><div class="row g-2">@foreach (var player in new[] { (Model.Battle.PlayerAId, Model.Battle.PlayerA.DisplayName), (Model.Battle.PlayerBId, Model.Battle.PlayerB.DisplayName) }) { <div class="col-6"><div class="d-grid gap-2">@foreach (var type in Enum.GetValues<ResultType>()) { <form method="post" asp-page-handler="Result"><input type="hidden" name="id" value="@Model.Battle.Id" /><input type="hidden" name="winnerPlayerId" value="@player.Item1" /><input type="hidden" name="resultType" value="@type" /><button class="btn btn-primary btn-lg">@player.Item2：@(type switch { ResultType.SpinFinish => "轉停 +1", ResultType.KnockOut => "擊飛 +2", ResultType.Burst => "爆裂 +2", _ => "極限 +3" })</button></form> }</div></div> }</div> } else { <form method="post" asp-page-handler="CompleteRound"><input type="hidden" name="id" value="@Model.Battle.Id" /><button class="btn btn-success btn-lg w-100 mt-3">完成此 Round</button></form> }}</section> }
