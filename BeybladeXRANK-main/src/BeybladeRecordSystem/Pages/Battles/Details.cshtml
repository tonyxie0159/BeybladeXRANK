@page "{id:int}"
@model BeybladeRecordSystem.Pages.Battles.DetailsModel
@using BeybladeRecordSystem.Domain.Enums
@{
    ViewData["Title"] = "對戰結算";
}

<header class="page-header">
    <div>
        <p class="eyebrow"><span></span>BATTLE RESULT</p>
        <h1>對戰結算</h1>
        <p>@(Model.Battle.Status == BattleStatus.Forfeited ? "本場因棄權結束，已完成對局仍保留於戰績。" : "本場對戰已正式完成。")</p>
    </div>
</header>

<section class="card card-body battle-result-card mb-3" aria-label="最終對戰結果">
    <p class="text-muted mb-2">@Model.WinnerTitle</p>
    <h2 class="result-winner">@Model.WinnerLabel</h2>
    <div class="scoreboard battle-scoreboard result-scoreboard" aria-label="最終比分">
        <div class="score-side side-b">
            <span class="side-name">B Side</span>
            <strong>@Model.BLabel</strong>
            <span class="score-value">@Model.BScore</span>
        </div>
        <div class="score-divider"><small>最終比分</small><strong>VS</strong></div>
        <div class="score-side side-x">
            <span class="side-name">X Side</span>
            <strong>@Model.XLabel</strong>
            <span class="score-value">@Model.XScore</span>
        </div>
    </div>
</section>

@if (Model.MyBeybladePerformance.Count > 0)
{
    <section class="card card-body mb-3" aria-labelledby="battle-configuration-performance">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div>
                <h2 id="battle-configuration-performance" class="h5 mb-1">本場配置表現</h2>
                <p class="text-muted mb-0">立即確認每個出戰版本在本場的得失分，再進入累計版本戰績比較。</p>
            </div>
            <a asp-page="/Statistics/Index" asp-route-view="blades" class="btn btn-outline-secondary btn-sm">全部陀螺戰績</a>
        </div>
        <div class="list-group list-group-flush">
            @foreach (var item in Model.MyBeybladePerformance)
            {
                <a asp-page="/Statistics/Beyblade"
                   asp-route-id="@item.BeybladeId"
                   asp-fragment="@(item.ConfigurationId is int configurationId ? $"version-{configurationId}" : "versions")"
                   class="list-group-item list-group-item-action px-0 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                    <span><strong>@item.Name</strong><small class="d-block text-muted">@item.RoundCount 局 · @item.Wins 勝 / @item.Losses 敗</small></span>
                    <span class="text-nowrap"><strong>得 @item.Score</strong> · 失 @item.AgainstScore <span aria-hidden="true">→</span></span>
                </a>
            }
        </div>
    </section>
}

<div class="page-actions">
    <a asp-page="/Index" class="btn btn-primary">回到首頁</a>
    <a asp-page="History" asp-route-id="@Model.Battle.Id" class="btn btn-outline-secondary">查看對戰紀錄</a>
    @if (Model.TournamentId is int tournamentId)
    {
        <a asp-page="/Tournaments/Details" asp-route-id="@tournamentId" class="btn btn-outline-secondary">返回賽事</a>
    }
</div>
