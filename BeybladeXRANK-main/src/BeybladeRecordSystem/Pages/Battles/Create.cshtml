@page
@model BeybladeRecordSystem.Pages.Battles.CreateModel
@{ ViewData["Title"] = "建立對戰"; }
<h1>建立對戰</h1>
<p class="text-muted">先送出站內邀請。對方接受後，雙方才會各自選擇自己的三顆陀螺。</p>
<form method="post" class="card card-body col-lg-7">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <label asp-for="OpponentId" class="form-label">選擇對手</label>
    <select asp-for="OpponentId" class="form-select mb-3">
        <option value="0">請選擇</option>
        @foreach (var opponent in Model.Opponents) { <option value="@opponent.Id">@opponent.DisplayName</option> }
    </select>
    <button class="btn btn-primary btn-lg">送出對戰邀請</button>
    <a asp-page="Invitations" class="btn btn-link">查看待處理邀請</a>
</form>
