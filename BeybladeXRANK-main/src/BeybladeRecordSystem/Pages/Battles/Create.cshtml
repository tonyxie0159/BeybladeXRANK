@page
@model BeybladeRecordSystem.Pages.Battles.CreateModel
@{ ViewData["Title"] = "建立對戰"; }
<h1>建立對戰</h1>
<form method="get" class="card card-body mb-3"><label class="form-label" for="opponentId">1. 選擇對手</label><select id="opponentId" name="opponentId" class="form-select" onchange="this.form.submit()"><option value="">請選擇</option>@foreach (var opponent in Model.Opponents) { <option value="@opponent.Id" selected="@(opponent.Id == Model.OpponentId)">@opponent.DisplayName</option> }</select></form>
@if (Model.OpponentId > 0) { <form method="post"><input asp-for="OpponentId" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="card card-body mb-3"><h2 class="h5">2. 選擇雙方三顆陀螺</h2><p class="text-muted">下列三個位置即為順位。每顆陀螺只能選一次。</p><div class="row g-3"><div class="col-md-6"><h3 class="h6">我方</h3>@for (var i = 0; i < 3; i++) { <label class="form-label">@((i + 1).ToString()) 號</label><select name="PlayerAIds" class="form-select mb-2"><option value="">請選擇</option>@foreach (var blade in Model.MyBeyblades) { <option value="@blade.Id">@blade.Name</option> }</select> }</div><div class="col-md-6"><h3 class="h6">對手</h3>@for (var i = 0; i < 3; i++) { <label class="form-label">@((i + 1).ToString()) 號</label><select name="PlayerBIds" class="form-select mb-2"><option value="">請選擇</option>@foreach (var blade in Model.OpponentBeyblades) { <option value="@blade.Id">@blade.Name</option> }</select> }</div></div></div><div class="card card-body"><h2 class="h5">3. 確認陣容</h2><p>送出後，雙方三顆陀螺與順位即鎖定，無法更換。</p><button class="btn btn-primary btn-lg">確認並鎖定陣容</button></div></form> }
