<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090d1a" />
    <title>@ViewData["Title"] - Beyblade X RANK</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BeybladeRecordSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-md navbar-dark" aria-label="主要導覽">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index" aria-label="Beyblade X RANK 首頁">
                    <span class="brand-mark" aria-hidden="true"><span>X</span></span>
                    <span class="brand-copy"><strong>BEYBLADE X</strong><small>RANK SYSTEM</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNavigation"
                        aria-controls="primaryNavigation" aria-expanded="false" aria-label="開啟導覽選單">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="primaryNavigation" class="navbar-collapse collapse">
                    <ul class="navbar-nav ms-auto align-items-md-center gap-md-1">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index">首頁</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Battles/Create">開始對戰</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Beyblades/Index">我的陀螺</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Statistics/Index">我的戰績</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Settings">帳號設定</a></li>
                            <li class="nav-item ms-md-2"><a class="btn btn-sm btn-outline-light nav-action" asp-page="/Account/Logout">登出</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="btn btn-sm btn-primary nav-action ms-md-2" asp-page="/Account/Login">登入</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="@(ViewData["FullBleed"] as bool? == true ? "" : "container py-4")">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2">
            <span>BEYBLADE X RANK</span>
            <span>&copy; 2026 對戰紀錄系統</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
