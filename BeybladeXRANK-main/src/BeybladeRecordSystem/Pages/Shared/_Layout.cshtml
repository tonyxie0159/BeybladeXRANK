<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090d1a" />
    <title>@ViewData["Title"] - Beyblade X RANK</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BeybladeRecordSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-md navbar-dark" aria-label="主要導覽">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index" aria-label="Beyblade X RANK 首頁">
                    <span class="brand-mark" aria-hidden="true"><span>X</span></span>
                    <span class="brand-copy"><strong>BEYBLADE X</strong><small>RANK SYSTEM</small></span>
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown notification-nav">
                        <button id="notificationBell" class="notification-bell" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="通知，沒有未讀訊息">
                            <span aria-hidden="true">🔔</span>
                            <span id="notificationBadge" class="notification-badge" hidden>!</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end notification-menu" aria-labelledby="notificationBell">
                            <div class="notification-menu-header"><strong>通知</strong><span id="notificationCountLabel">沒有未讀訊息</span></div>
                            <div id="notificationPreview" class="notification-preview"><p class="text-muted mb-0 p-3">正在同步通知…</p></div>
                            <a class="dropdown-item notification-all-link" asp-page="/Notifications/Index">查看全部通知</a>
                        </div>
                    </div>
                }
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNavigation"
                        data-collapsed-label="開啟導覽選單" data-expanded-label="關閉導覽選單"
                        aria-controls="primaryNavigation" aria-expanded="false" aria-label="開啟導覽選單">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="primaryNavigation" class="navbar-collapse collapse justify-content-end">
                    <ul class="navbar-nav align-items-md-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">首頁</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Tournaments/Index">比賽房間</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Battles/Create">快速對戰</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Battles/Invitations">對戰中心</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Beyblades/Index">我的陀螺</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Statistics/Index">我的戰績</a></li>
                            <li class="nav-item nav-account"><a class="nav-link" asp-page="/Account/Settings"><span class="nav-user-dot" aria-hidden="true"></span>@User.Identity.Name</a></li>
                            <li class="nav-item"><a class="nav-link nav-logout" asp-page="/Account/Logout">登出</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">登入</a></li>
                            <li class="nav-item"><a class="btn btn-primary nav-action" asp-page="/Account/Register">建立帳號</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" role="main" tabindex="-1" class="@(ViewData["FullBleed"] as bool? == true ? "" : "container content-shell")">
        @RenderBody()
    </main>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <form id="notificationActionForm" method="post" hidden>@Html.AntiForgeryToken()</form>
        <div id="notificationToastRegion" class="notification-toast-region" aria-live="polite" aria-atomic="false"></div>
        <nav class="mobile-dock" aria-label="手機快速導覽">
            <a asp-page="/Index"><span aria-hidden="true">⌂</span><small>首頁</small></a>
            <a asp-page="/Battles/Invitations"><span aria-hidden="true">⚔</span><small>對戰</small></a>
            <a asp-page="/Tournaments/Index"><span aria-hidden="true">◆</span><small>賽事</small></a>
            <a asp-page="/Statistics/Index"><span aria-hidden="true">▥</span><small>戰績</small></a>
        </nav>
    }

    <footer class="site-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2">
            <span>BEYBLADE X RANK</span>
            <span>&copy; 2026 對戰紀錄系統</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
