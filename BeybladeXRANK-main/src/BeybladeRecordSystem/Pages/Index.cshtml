@page
@using BeybladeRecordSystem.Infrastructure
@model IndexModel
@{ ViewData["Title"] = "首頁"; }
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="py-3">
        <h1 class="display-6">Beyblade 戰績</h1>
        <p class="lead">歡迎回來，@User.Identity.Name。</p>
        @if (Model.PendingQuickBattleInvitations > 0)
        {
            <div class="alert alert-warning"><a asp-page="/Battles/Invitations" class="alert-link">你有 @Model.PendingQuickBattleInvitations 筆快速對戰邀請待處理</a></div>
        }
        @if (Model.ActiveQuickBattles.Any())
        {
            <section class="card card-body mb-3 col-lg-8">
                <h2 class="h5">繼續快速對戰</h2>
                <div class="list-group list-group-flush">
                    @foreach (var active in Model.ActiveQuickBattles)
                    {
                        var battle = active.Battle;
                        var opponent = battle.PlayerAId == User.GetRequiredUserId() ? battle.PlayerB : battle.PlayerA;
                        var destinationPage = active.Target switch
                        {
                            BeybladeRecordSystem.Services.QuickBattleResumeTarget.Setup => "/Battles/Setup",
                            BeybladeRecordSystem.Services.QuickBattleResumeTarget.Reorder => "/Battles/Reorder",
                            _ => "/Battles/Battle"
                        };
                        var actionLabel = active.Target switch
                        {
                            BeybladeRecordSystem.Services.QuickBattleResumeTarget.Setup => "繼續準備",
                            BeybladeRecordSystem.Services.QuickBattleResumeTarget.Reorder => "繼續重排",
                            _ => battle.Status == BeybladeRecordSystem.Domain.Enums.BattleStatus.VictoryPendingCompletion ? "確認對戰結果" : "返回計分"
                        };
                        <a asp-page="@destinationPage" asp-route-id="@battle.Id" class="list-group-item list-group-item-action d-flex flex-column flex-md-row justify-content-between gap-1 px-0">
                            <span>對手：<strong>@opponent.DisplayName</strong></span>
                            <span>@actionLabel →</span>
                        </a>
                    }
                </div>
            </section>
        }
        <div class="d-grid gap-3 col-md-6">
            <a asp-page="/Battles/Create" class="btn btn-primary btn-lg py-3">發起快速對戰</a>
            <a asp-page="/Battles/Invitations" class="btn btn-outline-primary btn-lg py-3">對戰邀請</a>
            <a asp-page="/Beyblades/Index" class="btn btn-outline-primary btn-lg py-3">我的陀螺</a>
            <a asp-page="/Statistics/Index" class="btn btn-outline-primary btn-lg py-3">我的戰績</a>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <h1 class="display-5">Beyblade 戰績</h1>
        <p class="lead">記錄每一場 1v1 對戰。</p>
        <a asp-page="/Account/Login" class="btn btn-primary btn-lg">登入</a>
        <a asp-page="/Account/Register" class="btn btn-outline-primary btn-lg">建立帳號</a>
    </div>
}
