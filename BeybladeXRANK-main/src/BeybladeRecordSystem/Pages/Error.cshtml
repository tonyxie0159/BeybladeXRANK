@page
@model ErrorModel
@{
    ViewData["Title"] = "發生錯誤";
}

<div class="auth-shell"><div class="card auth-card text-center"><p class="eyebrow">SYSTEM NOTICE</p><h1>頁面暫時無法處理</h1><p class="text-muted">資料尚未因這個畫面而再次送出。請回到首頁後重試；如果問題持續發生，可將下方追蹤編號提供給維護人員。</p>
@if (Model.ShowRequestId) { <p class="small"><strong>追蹤編號：</strong><code>@Model.RequestId</code></p> }
<a asp-page="/Index" class="btn btn-primary">返回首頁</a></div></div>
