@page
@model BeybladeRecordSystem.Pages.Tournaments.IndexModel
@using BeybladeRecordSystem.Services
@{ ViewData["Title"] = "比賽房間"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>比賽房間</h1>
    <a asp-page="Create" class="btn btn-primary">建立比賽</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-5">
        <select asp-for="Filter" asp-items="Html.GetEnumSelectList<TournamentListFilter>()" class="form-select"></select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-primary">套用篩選</button></div>
</form>
@if (!Model.Result.Items.Any())
{
    <div class="alert alert-secondary">目前沒有符合條件的比賽。</div>
}
<div class="row g-3">
@foreach (var item in Model.Result.Items)
{
    <div class="col-12">
        <article class="card"><div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <div><h2 class="h5 mb-1">@item.Name</h2><div class="text-muted">主辦：@item.OrganizerDisplayName</div></div>
                <div><span class="badge text-bg-primary">@item.Status</span> <span class="badge text-bg-secondary">@item.RegistrationStage</span></div>
            </div>
            <p class="my-2">@item.RuleSummary</p>
            <div class="small mb-3">有效報名：@item.RegisteredEntryCount / @item.TargetEntryCount @if (item.IsOrganizer) { <span class="badge text-bg-warning">我主辦的</span> } @if (item.IsParticipant) { <span class="badge text-bg-success">已參加</span> }</div>
            <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">查看詳情</a>
        </div></article>
    </div>
}
</div>
@if (Model.Result.TotalPages > 1)
{
    <nav class="mt-3"><ul class="pagination">
        @for (var pageNumber = 1; pageNumber <= Model.Result.TotalPages; pageNumber++)
        {
            <li class="page-item @(pageNumber == Model.Result.PageNumber ? "active" : null)"><a class="page-link" asp-route-pageNumber="@pageNumber" asp-route-filter="@Model.Filter">@pageNumber</a></li>
        }
    </ul></nav>
}
