@page
@model BeybladeRecordSystem.Pages.Tournaments.IndexModel
@using BeybladeRecordSystem.Domain.Enums
@using BeybladeRecordSystem.Domain.Tournaments
@using BeybladeRecordSystem.Services
@{ ViewData["Title"] = "比賽房間"; }
<header class="page-header"><div><p class="eyebrow">TOURNAMENTS</p><h1>比賽房間</h1><p>報名賽事、處理待辦，或建立自己的比賽。</p></div>
    <div class="page-actions"><a asp-page="Index" asp-route-filter="@Model.Filter" asp-route-pageNumber="@Model.PageNumber" class="btn btn-outline-secondary">手動刷新</a><a asp-page="Create" class="btn btn-primary">＋ 建立比賽</a></div>
</header>
<form method="get" class="toolbar">
    <div class="col-sm-8 col-md-5">
        <select asp-for="Filter" class="form-select"><option value="All">全部賽事</option><option value="WaitingForMe">等待我處理</option><option value="RegistrationOpen">開放報名</option><option value="InProgress">進行中</option><option value="Completed">已完成</option><option value="Cancelled">已取消</option><option value="Participating">我參加的</option><option value="Hosted">我主辦的</option></select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-primary">套用篩選</button></div>
</form>
@if (!Model.Result.Items.Any())
{
    <div class="empty-state"><h2>目前沒有符合條件的比賽</h2><p class="text-muted">調整篩選條件，或建立第一場比賽。</p><a asp-page="Create" class="btn btn-primary">建立比賽</a></div>
}
<div class="row g-3">
@foreach (var item in Model.Result.Items)
{
    var modeLabel = item.Mode == TournamentMode.Individual ? "個人賽" : "團體賽";
    var registrationLabel = TournamentDisplay.Label(item.RegistrationMode);
    var formatLabel = TournamentDisplay.Label(item.Format);
    <div class="col-12">
        <article class="card"><div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <div><h2 class="h5 mb-1">@item.Name</h2><div class="text-muted">主辦：@item.OrganizerDisplayName</div></div>
                <div><span class="badge @TournamentDisplay.BadgeClass(item.Status)">@TournamentDisplay.Label(item.Status)</span> <span class="badge @TournamentDisplay.BadgeClass(item.RegistrationStage)">@TournamentDisplay.Label(item.RegistrationStage)</span></div>
            </div>
            <div class="d-flex flex-wrap gap-1 my-2">
                <span class="badge text-bg-light">@modeLabel</span>
                <span class="badge text-bg-light">@registrationLabel</span>
                <span class="badge text-bg-light">@formatLabel</span>
                <span class="badge text-bg-light">@TournamentRuleCatalog.Get(item.RuleSet).DisplayName</span>
            </div>
            <p class="mb-1">@item.RuleSummary</p>
            @if (!string.IsNullOrWhiteSpace(item.Notes)) { <p class="small text-muted mb-2">備註：@item.Notes</p> }
            <div class="small mb-3">有效報名：@item.RegisteredEntryCount / @item.TargetEntryCount @if (item.IsOrganizer) { <span class="badge text-bg-warning">主辦方</span> } @if (item.IsParticipant) { <span class="badge text-bg-success">參賽者</span> } @if (item.HasPendingAction) { <span class="badge text-bg-danger">@item.PendingActionLabel</span> }</div>
            <div class="d-flex flex-wrap gap-2">
                @if (item.ActionMatchId is int actionMatchId)
                {
                    <a asp-page="Match" asp-route-id="@actionMatchId" class="btn btn-primary">@item.PendingActionLabel</a>
                    <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">賽事詳情</a>
                }
                else
                {
                    <a asp-page="Details" asp-route-id="@item.Id" class="btn @(item.HasPendingAction ? "btn-primary" : "btn-outline-primary")">@(item.PendingActionLabel ?? (item.IsOrganizer ? "管理賽事" : item.IsParticipant ? "參賽詳情" : "查看詳情"))</a>
                }
            </div>
        </div></article>
    </div>
}
</div>
@if (Model.Result.TotalPages > 1)
{
    <nav class="mt-3"><ul class="pagination">
        @for (var pageNumber = 1; pageNumber <= Model.Result.TotalPages; pageNumber++)
        {
            <li class="page-item @(pageNumber == Model.Result.PageNumber ? "active" : null)"><a class="page-link" asp-route-pageNumber="@pageNumber" asp-route-filter="@Model.Filter">@pageNumber</a></li>
        }
    </ul></nav>
}
<div id="tournament-list-poll-state" data-token="@Model.PollToken" hidden></div>

@section Scripts {
<script>
(() => {
    const state = document.getElementById('tournament-list-poll-state');
    if (!state) return;
    const initialToken = state.dataset.token;
    const pollUrl = new URL(window.location.href);
    pollUrl.searchParams.set('handler', 'Poll');
    window.setInterval(async () => {
        if (document.hidden) return;
        try {
            const response = await fetch(pollUrl, { method: 'GET', cache: 'no-store', headers: { 'Accept': 'application/json' } });
            if (!response.ok) return;
            const payload = await response.json();
            if (payload.token && payload.token !== initialToken) window.location.reload();
        } catch { }
    }, 60000);
})();
</script>
}
