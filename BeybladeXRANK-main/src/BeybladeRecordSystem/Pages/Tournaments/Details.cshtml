@page "{id:int}"
@model BeybladeRecordSystem.Pages.Tournaments.DetailsModel
@using BeybladeRecordSystem.Domain.Enums
@using BeybladeRecordSystem.Domain.Tournaments
@using BeybladeRecordSystem.Infrastructure
@using BeybladeRecordSystem.Services
@{ var details = Model.PublicDetails; ViewData["Title"] = details.Name; var registered = details.Entries.Count; var isElimination = Model.Tournament.Format is TournamentFormat.SingleElimination or TournamentFormat.DoubleElimination; var hasChampionPlayoff = Model.Tournament.Matches.Any(x => x.Bracket == TournamentBracket.Playoff); }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div><h1>@details.Name</h1><div class="text-muted">主辦：@details.OrganizerDisplayName</div></div>
    <div class="text-end"><div><span class="badge @TournamentDisplay.BadgeClass(details.Status)">@TournamentDisplay.Label(details.Status)</span> <span class="badge @TournamentDisplay.BadgeClass(details.RegistrationStage)">@TournamentDisplay.Label(details.RegistrationStage)</span></div><a asp-page="Details" asp-route-id="@details.Id" class="btn btn-sm btn-outline-secondary mt-2">手動刷新</a></div>
</div>
<div id="tournament-poll-state" data-token="@details.PollToken" hidden></div>

@section Scripts {
<script src="~/js/player-search.js" asp-append-version="true"></script>
<script>
(() => {
    const state = document.getElementById('tournament-poll-state');
    if (!state) return;
    const initialToken = state.dataset.token;
    const pollUrl = new URL(window.location.href);
    pollUrl.searchParams.set('handler', 'Poll');
    window.setInterval(async () => {
        if (document.hidden) return;
        try {
            const response = await fetch(pollUrl, { method: 'GET', cache: 'no-store', headers: { 'Accept': 'application/json' } });
            if (!response.ok) return;
            const payload = await response.json();
            if (payload.token && payload.token !== initialToken) window.location.reload();
        } catch { }
    }, 60000);
})();
</script>
}
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (details.Status == TournamentStatus.Cancelled)
{
    <div class="alert alert-warning"><strong>此比賽已取消。</strong>
    @if (!string.IsNullOrWhiteSpace(details.CancellationReason)) { <span>原因：@details.CancellationReason</span> }
    <div class="small mt-1">已完成的對局與回合資料仍保留；未完成回合不列入統計。</div></div>
}
<section class="card card-body mb-3">
    <h2 class="h5">比賽規則</h2><p>@details.RulesSnapshot</p>
    @if (!string.IsNullOrWhiteSpace(details.Notes)) { <h3 class="h6">主辦方備註</h3><p>@details.Notes</p> }
    <div class="row small text-muted g-2"><div class="col-md-6">建立：@details.CreatedAtUtc.ToLocalTime().ToString("g")</div>
    @if (details.StartedAtUtc is DateTime started) { <div class="col-md-6">正式開始：@started.ToLocalTime().ToString("g")</div> }
    @if (details.CompletedAtUtc is DateTime completed) { <div class="col-md-6">完成：@completed.ToLocalTime().ToString("g")</div> }
    </div>
</section>
@if (Model.ParticipantInvitation is not null)
{
    <section class="card card-body border-warning mb-3">
        <h2 class="h5">參賽邀請</h2>
        <p><strong>@Model.ParticipantInvitation.InvitedByUser.DisplayName</strong> 邀請你參加這場個人賽。接受後才會建立正式 Entry；拒絕不算棄權。</p>
        <div class="d-flex gap-2">
            <form method="post" asp-page-handler="RespondParticipantInvitation">
                <input type="hidden" name="id" value="@Model.Tournament.Id" />
                <input type="hidden" name="invitationId" value="@Model.ParticipantInvitation.Id" />
                <input type="hidden" name="accept" value="true" />
                <button class="btn btn-success">接受並報名</button>
            </form>
            <form method="post" asp-page-handler="RespondParticipantInvitation">
                <input type="hidden" name="id" value="@Model.Tournament.Id" />
                <input type="hidden" name="invitationId" value="@Model.ParticipantInvitation.Id" />
                <input type="hidden" name="accept" value="false" />
                <button class="btn btn-outline-secondary">拒絕</button>
            </form>
        </div>
    </section>
}
@if (Model.IsOrganizer && Model.Tournament.Mode == TournamentMode.Individual &&
    Model.Tournament.Status == TournamentStatus.RegistrationOpen &&
    Model.Tournament.RegistrationStage == TournamentRegistrationStage.Open)
{
    <section class="card card-body mb-3">
        <h2 class="h5">邀請參賽者</h2>
        <form method="post" asp-page-handler="InviteParticipant" class="row g-2">
            <input type="hidden" name="id" value="@Model.Tournament.Id" />
            <div class="col-md-8">
                <label for="inviteParticipantSearch" class="form-label">搜尋玩家名稱</label>
                <div class="player-search"><input id="inviteParticipantSearch" class="form-control" autocomplete="off" data-player-search data-target="InviteParticipantUserId" data-results="inviteParticipantResults" data-tournament-id="@Model.Tournament.Id" placeholder="輸入至少一個字" /><input asp-for="InviteParticipantUserId" type="hidden" /><div id="inviteParticipantResults" class="player-search-results" hidden></div></div>
            </div>
            <div class="col-md-4 d-flex align-items-end"><button class="btn btn-outline-primary w-100">發送參賽邀請</button></div>
        </form>
    </section>
}
@if (details.Matches.Any())
{
    <section class="card card-body mb-3">
        <h2 class="h5">完整賽程@(details.Status == TournamentStatus.RegistrationOpen ? "草稿" : null)</h2>
        <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>順序</th><th>出戰隊伍</th><th>對戰結果</th></tr></thead><tbody>
        @foreach (var match in details.Matches)
        {
            <tr class="@(match.IsCurrent ? "table-warning" : null)">
                <td>@match.SequenceNumber @if (match.IsCurrent) { <span class="badge text-bg-warning">目前對局</span> }</td>
                <td>@match.SideALabel vs @match.SideBLabel</td>
                <td>
                    <span class="badge @TournamentDisplay.BadgeClass(match.Status)">@TournamentDisplay.Label(match.Status)</span>
                    @if (match.IsBye)
                    {
                        <span> @match.SideALabel 輪空／自動晉級</span>
                    }
                    else if (match.Status == TournamentMatchStatus.Walkover && match.WinnerLabel is not null)
                    {
                        <span> @match.WinnerLabel 不戰勝</span>
                    }
                    else if (match.WinnerLabel is not null)
                    {
                        <strong> 勝方：@match.WinnerLabel</strong>
                        @if (match.Battle is { } publicBattle) { <span>，比分 @publicBattle.SideAScore：@publicBattle.SideBScore</span> }
                    }
                    @if (match.CanOpenWorkspace) { <a asp-page="Match" asp-route-id="@match.Id" class="d-block small mt-1">前往對局</a> }
                </td>
            </tr>
        }
        </tbody></table></div>
        @if (Model.IsOrganizer && Model.Tournament.Status == TournamentStatus.RegistrationOpen && Model.Tournament.RegistrationStage == TournamentRegistrationStage.ScheduleDraftCreated)
        {
            var positionedEntries = Model.Tournament.Entries.OrderBy(x => x.SchedulePosition).ToList();
            <details class="mt-2"><summary class="btn btn-outline-secondary">調整 Entry 賽程位置</summary><form method="post" asp-page-handler="ReorderSchedule" class="mt-3"><input type="hidden" name="id" value="@Model.Tournament.Id" />@for (var position = 0; position < positionedEntries.Count; position++) { <label class="form-label">位置 @(position + 1)</label><select name="OrderedEntryIds" class="form-select mb-2">@foreach (var entry in positionedEntries) { <option value="@entry.Id" selected="@(entry.Id == positionedEntries[position].Id)">@entry.DisplayNameSnapshot</option> }</select> }<button class="btn btn-warning">儲存位置並保留賽程結構</button></form></details>
        }
    </section>
}
@if (Model.ActionMatches.Any())
{
    <section class="card card-body mb-3"><h2 class="h5">等待我處理</h2><div class="list-group">
    @foreach (var action in Model.ActionMatches) { <a asp-page="Match" asp-route-id="@action.MatchId" class="list-group-item list-group-item-action d-flex justify-content-between"><span>對局 #@action.SequenceNumber：@action.Label</span><span>@TournamentDisplay.Label(action.Status)</span></a> }
    </div></section>
}
@if (Model.Standings.Any())
{
    <section class="card card-body mb-3">
        <h2 class="h5">@(Model.Tournament.Status == TournamentStatus.Completed ? "正式排名" : "目前排名")</h2>
        <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>名次</th><th>@(Model.Tournament.Mode == TournamentMode.Team ? "參賽隊伍" : "參賽者")</th><th>勝</th><th>敗</th><th>總得失分</th></tr></thead><tbody>
        @foreach (var row in Model.Standings)
        {
            <tr><td>@row.Rank@if (row.IsTied) { <span class="text-muted">（並列）</span> }</td><td>@row.DisplayName @if (row.Placement == TournamentStandingPlacement.Champion) { <span class="badge text-bg-warning">冠軍</span> }</td><td>@row.Wins</td><td>@row.Losses</td><td>@row.ScoreDifference</td></tr>
        }
        </tbody></table></div>
        <details class="mt-3"><summary>排名依據</summary>
            <p class="small text-muted mt-2">勝場相同時，兩隊優先比較直接對戰；三隊以上同分則比較同分群組內得失分，再比較全賽事總得失分與總得分。瑞士輪另依對手分（Buchholz）及對手勝率排序。輪空不計勝敗；不戰勝計一勝一敗，但不計得失分。</p>
            <div class="table-responsive"><table class="table table-sm"><thead><tr><th>參賽者／隊伍</th><th>直接對戰</th><th>同分群組差</th><th>總得分</th><th>對手分</th><th>對手勝率</th></tr></thead><tbody>
            @foreach (var row in Model.Standings) { <tr><td>@row.DisplayName</td><td>@(row.DirectEncounterWins > 0 ? "勝" : "—")</td><td>@row.GroupScoreDifference</td><td>@row.PointsFor</td><td>@row.Buchholz</td><td>@row.OpponentWinRate.ToString("P1")</td></tr> }
            </tbody></table></div>
        </details>
    </section>
}
@{ var standingByEntry = Model.Standings.ToDictionary(x => x.EntryId); }
<section class="card card-body mb-3">
    <div class="d-flex justify-content-between"><h2 class="h5">@(Model.Tournament.Mode == TournamentMode.Team ? "參賽隊伍" : "參賽者列表")</h2><strong>@registered / @details.TargetEntryCount</strong></div>
    @if (!details.Entries.Any()) { <p class="text-muted mb-0">尚無參賽者。</p> }
    else { <ol class="mb-0">@foreach (var entry in details.Entries) { var record = standingByEntry.GetValueOrDefault(entry.Id); <li><strong>@entry.DisplayName</strong> <span class="text-muted">勝 @(record?.Wins ?? 0)／敗 @(record?.Losses ?? 0)</span>@if (entry.MemberDisplayNames.Any()) { <div class="small text-muted">成員：@string.Join("、", entry.MemberDisplayNames)</div> }</li> }</ol> }
</section>
@if (Model.Tournament.Mode == TournamentMode.Team && Model.Tournament.RegistrationMode == TournamentRegistrationMode.CompleteTeam && Model.Tournament.Status == TournamentStatus.RegistrationOpen)
{
    <section class="card card-body mb-3">
        <h2 class="h5">我的團體隊伍</h2>
        @if (Model.TeamWorkspace.PendingInvitations.Any())
        {
            <h3 class="h6">待處理邀請</h3>
            @foreach (var invitation in Model.TeamWorkspace.PendingInvitations)
            {
                var teamLabel = invitation.TournamentEntry!.TeamName ?? string.Join(" / ", invitation.TournamentEntry.Members.OrderBy(x => x.MemberOrder).Select(x => x.DisplayNameSnapshot));
                <div class="border rounded p-2 mb-2"><strong>@teamLabel</strong> 邀請你加入
                    <form method="post" asp-page-handler="RespondInvitation" class="d-inline"><input type="hidden" name="id" value="@Model.Tournament.Id" /><input type="hidden" name="invitationId" value="@invitation.Id" /><input type="hidden" name="accept" value="true" /><button class="btn btn-success btn-sm">接受</button></form>
                    <form method="post" asp-page-handler="RespondInvitation" class="d-inline"><input type="hidden" name="id" value="@Model.Tournament.Id" /><input type="hidden" name="invitationId" value="@invitation.Id" /><input type="hidden" name="accept" value="false" /><button class="btn btn-outline-secondary btn-sm">拒絕</button></form>
                </div>
            }
        }
        @if (Model.TeamWorkspace.PendingRepresentativeTransfers.Any())
        {
            <h3 class="h6">代表人轉讓</h3>
            @foreach (var invitation in Model.TeamWorkspace.PendingRepresentativeTransfers)
            {
                <div class="border rounded p-2 mb-2"><strong>@invitation.InvitedByUser.DisplayName</strong> 邀請你接任隊伍代表人
                    <form method="post" asp-page-handler="RespondRepresentativeTransfer" class="d-inline"><input type="hidden" name="id" value="@Model.Tournament.Id" /><input type="hidden" name="invitationId" value="@invitation.Id" /><input type="hidden" name="accept" value="true" /><button class="btn btn-success btn-sm">接受</button></form>
                    <form method="post" asp-page-handler="RespondRepresentativeTransfer" class="d-inline"><input type="hidden" name="id" value="@Model.Tournament.Id" /><input type="hidden" name="invitationId" value="@invitation.Id" /><input type="hidden" name="accept" value="false" /><button class="btn btn-outline-secondary btn-sm">拒絕</button></form>
                </div>
            }
        }
        @if (Model.TeamWorkspace.Team is null)
        {
            <form method="post" asp-page-handler="CreateTeam" class="row g-2"><input type="hidden" name="id" value="@Model.Tournament.Id" /><div class="col-md-8"><label asp-for="TeamName" class="form-label">隊名（選填）</label><input asp-for="TeamName" class="form-control" maxlength="100" /></div><div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary w-100">建立臨時隊伍</button></div></form>
        }
        else
        {
            var team = Model.TeamWorkspace.Team;
            var me = team.Members.Single(x => x.UserId == User.GetRequiredUserId());
            <div class="d-flex justify-content-between"><strong>@(team.TeamName ?? "未命名隊伍")</strong><span>@TournamentDisplay.Label(team.Status)｜@team.Members.Count / @Model.Tournament.TeamSize 人</span></div>
            <ul>@foreach (var member in team.Members.OrderBy(x => x.MemberOrder)) { <li>@member.DisplayNameSnapshot @if (member.IsRepresentative) { <span class="badge text-bg-warning">代表人</span> }</li> }</ul>
            @if (me.IsRepresentative && team.Status == TournamentEntryStatus.Pending && team.Members.Count < Model.Tournament.TeamSize)
            {
                <form method="post" asp-page-handler="InviteTeamMember" class="row g-2 mb-2"><input type="hidden" name="id" value="@Model.Tournament.Id" /><input type="hidden" name="entryId" value="@team.Id" /><div class="col-md-8"><label for="inviteTeamPlayerSearch" class="form-label">搜尋玩家名稱</label><div class="player-search"><input id="inviteTeamPlayerSearch" class="form-control" autocomplete="off" data-player-search data-target="InvitePlayerUserId" data-results="inviteTeamPlayerResults" data-tournament-id="@Model.Tournament.Id" placeholder="輸入至少一個字" /><input asp-for="InvitePlayerUserId" type="hidden" /><div id="inviteTeamPlayerResults" class="player-search-results" hidden></div></div></div><div class="col-md-4 d-flex align-items-end"><button class="btn btn-outline-primary w-100">發送邀請</button></div></form>
            }
            @if (me.IsRepresentative && team.Status == TournamentEntryStatus.Pending && team.Members.Count == Model.Tournament.TeamSize)
            {
                <form method="post" asp-page-handler="RegisterTeam" class="mb-2"><input type="hidden" name="id" value="@Model.Tournament.Id" /><input type="hidden" name="entryId" value="@team.Id" /><button class="btn btn-success">確認整隊正式報名</button></form>
            }
            @if (me.IsRepresentative && team.Members.Count > 1)
            {
                <form method="post" asp-page-handler="TransferRepresentative" class="row g-2 mb-2"><input type="hidden" name="id" value="@Model.Tournament.Id" /><input type="hidden" name="entryId" value="@team.Id" /><div class="col-md-8"><select asp-for="NewRepresentativeId" class="form-select">@foreach (var member in team.Members.Where(x => x.UserId != me.UserId)) { <option value="@member.UserId">@member.DisplayNameSnapshot</option> }</select></div><div class="col-md-4"><button class="btn btn-outline-warning w-100">提出代表人轉讓</button></div></form>
            }
            <form method="post" asp-page-handler="LeaveTeam"><input type="hidden" name="id" value="@Model.Tournament.Id" /><button class="btn btn-outline-danger" onclick="return confirm('確定退出這支隊伍？')">退出隊伍</button></form>
        }
    </section>
}
@if (Model.Tournament.Mode == TournamentMode.Team && Model.Tournament.RegistrationMode == TournamentRegistrationMode.SystemAssignedTeam && Model.Tournament.Status == TournamentStatus.RegistrationOpen)
{
    <section class="card card-body mb-3">
        <h2 class="h5">系統配隊</h2>
        @if (!Model.IsSystemPairingRegistered && Model.Tournament.RegistrationStage == TournamentRegistrationStage.Open)
        {
            <p>先以個人身分登記；報名關閉後系統才會隨機組成完整隊伍。</p>
            <form method="post" asp-page-handler="RegisterForPairing"><input type="hidden" name="id" value="@Model.Tournament.Id" /><button class="btn btn-primary">登記系統配隊</button></form>
        }
        else if (Model.TeamWorkspace.Team is not null)
        {
            var pairingTeam = Model.TeamWorkspace.Team;
            <div class="alert @(pairingTeam.Status == TournamentEntryStatus.Registered ? "alert-success" : "alert-secondary")">
                @if (pairingTeam.Status == TournamentEntryStatus.Registered) { <strong>目前配隊：</strong> @pairingTeam.DisplayNameSnapshot }
                else { <strong>等待配隊或補足隊員。</strong> }
            </div>
            <form method="post" asp-page-handler="WithdrawFromPairing"><input type="hidden" name="id" value="@Model.Tournament.Id" /><button class="btn btn-outline-danger" onclick="return confirm('確定取消配隊登記？')">取消配隊登記</button></form>
        }
        @if (Model.IsOrganizer)
        {
            var activePlayers = Model.SystemPairingEntries.Sum(x => x.Members.Count);
            <hr /><h3 class="h6">主辦方配隊管理</h3><p>目前有效玩家：@activePlayers；完整隊伍：@Model.SystemPairingEntries.Count(x => x.Status == TournamentEntryStatus.Registered)；等待補足：@Model.SystemPairingEntries.Count(x => x.Status == TournamentEntryStatus.Pending)</p>
            @if (Model.Tournament.RegistrationStage is TournamentRegistrationStage.Closed or TournamentRegistrationStage.AwaitingTeamFormation)
            {
                <form method="post" asp-page-handler="GenerateSystemTeams" class="d-inline"><input type="hidden" name="id" value="@Model.Tournament.Id" /><button class="btn btn-warning">隨機重新配隊</button></form>
            }
            @if (Model.Tournament.RegistrationStage == TournamentRegistrationStage.Closed && Model.SystemPairingEntries.Count(x => x.Status == TournamentEntryStatus.Registered) >= 2)
            {
                var assignedMembers = Model.SystemPairingEntries.Where(x => x.Status == TournamentEntryStatus.Registered).SelectMany(x => x.Members).ToList();
                <form method="post" asp-page-handler="SwapMembers" class="row g-2 mt-2"><input type="hidden" name="id" value="@Model.Tournament.Id" /><div class="col-md-5"><select asp-for="FirstMemberId" class="form-select">@foreach (var member in assignedMembers) { <option value="@member.Id">@member.DisplayNameSnapshot</option> }</select></div><div class="col-md-5"><select asp-for="SecondMemberId" class="form-select">@foreach (var member in assignedMembers) { <option value="@member.Id">@member.DisplayNameSnapshot</option> }</select></div><div class="col-md-2"><button class="btn btn-outline-warning w-100">交換</button></div></form>
            }
        }
    </section>
}
<div class="d-flex flex-wrap gap-2">
    @if (Model.CanReopenRegistration) { <form method="post" asp-page-handler="ReopenRegistration" onsubmit="return confirm('重新開放會清除尚未正式開始的賽程草稿與位置；已失效邀請不會自動恢復。確定繼續？')"><input type="hidden" name="id" value="@Model.Tournament.Id" /><button class="btn btn-outline-primary">重新開放報名</button></form> }
    @if (Model.IsOrganizer && Model.Tournament.Status == TournamentStatus.RegistrationOpen && Model.Tournament.RegistrationStage == TournamentRegistrationStage.Closed) { <form method="post" asp-page-handler="GenerateSchedule"><input type="hidden" name="id" value="@Model.Tournament.Id" /><button class="btn btn-primary">產生賽程草稿</button></form> }
    @if (Model.IsOrganizer && Model.Tournament.Status == TournamentStatus.RegistrationOpen && Model.Tournament.RegistrationStage == TournamentRegistrationStage.ScheduleDraftCreated) { <form method="post" asp-page-handler="StartTournament"><input type="hidden" name="id" value="@Model.Tournament.Id" /><button class="btn btn-success" onclick="return confirm('正式開始後將鎖定參賽者與賽程，確定開始？')">正式開始比賽</button></form><form method="post" asp-page-handler="AbandonSchedule"><input type="hidden" name="id" value="@Model.Tournament.Id" /><button class="btn btn-outline-danger">放棄賽程草稿</button></form> }
    @if (Model.CanRegister) { <form method="post" asp-page-handler="Register"><input type="hidden" name="id" value="@Model.Tournament.Id" /><button class="btn btn-primary">我要報名</button></form> }
    @if (Model.IsRegistered && Model.Tournament.Mode == TournamentMode.Individual && Model.Tournament.Status == TournamentStatus.RegistrationOpen) { <form method="post" asp-page-handler="Withdraw"><input type="hidden" name="id" value="@Model.Tournament.Id" /><button class="btn btn-outline-danger" onclick="return confirm('確定取消報名？')">取消報名</button></form> }
    @if (Model.IsOrganizer && Model.Tournament.Status == TournamentStatus.RegistrationOpen && Model.Tournament.RegistrationStage is TournamentRegistrationStage.Open or TournamentRegistrationStage.CapacityReached) { <form method="post" asp-page-handler="CloseRegistration"><input type="hidden" name="id" value="@Model.Tournament.Id" /><button class="btn btn-warning">關閉報名</button></form> }
    @if (Model.IsOrganizer && Model.Tournament.Status is not (TournamentStatus.Completed or TournamentStatus.Cancelled))
    {
        <details><summary class="btn btn-outline-danger">取消整場比賽</summary><form method="post" asp-page-handler="CancelTournament" class="card card-body mt-2" onsubmit="return confirm('取消後不能繼續進行此賽事。已完成資料會保留，確定取消？')"><input type="hidden" name="id" value="@Model.Tournament.Id" /><label asp-for="CancellationReason" class="form-label">取消原因（選填）</label><textarea asp-for="CancellationReason" class="form-control mb-2" maxlength="500"></textarea><button class="btn btn-danger">確認取消</button></form></details>
    }
    <a asp-page="Index" class="btn btn-link">返回比賽房間</a>
</div>
